<!--pages/center/message.wxml-->
<wxs src="../../utils/tool.wxs" module="tools"></wxs>
<block wx:for="{{array}}">
    <view class="item" bindtap="gopage" data-id="{{item.oid}}" data-type="{{item.type}}" data-state="{{item.state}}">
        <view class="f-32 f-b">{{item.content}}</view>
        <view class="flex-sp m-t-40">
            <view class="msgtype" wx:if="{{item.type==1}}">出租审核</view>
            <view class="msgtype" wx:if="{{item.type==2}}">{{bkinfo.commission}}审核</view>
            <view class="msgtype" wx:if="{{item.type==3}}">成交审核</view>
            <view class="msgtype" wx:if="{{item.type==4}}">提现审核</view>
            <view class="msgtype" wx:if="{{item.type==5}}">{{bkinfo.broker}}审核</view>
            <view class="c-9 f-24">发布时间：{{tools.substr(item.created_at,16)}}</view>
        </view>
    </view>
</block>

<view class="emptyview" wx:if="{{array.length==0}}">
        <image src="../../images/e2.png" mode="aspectFit"></image>
        <text class="c-9 f-24">暂无消息数据~</text>
    </view>