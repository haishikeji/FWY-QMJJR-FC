/* pages/center/myrent.wxss */

.tabbar
{
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 30rpx;
    box-sizing: border-box;
    position: fixed;
    left: 0;
    top: 0;
    z-index: 9;
    background-color: #ffffff;
    width: 100%;
}
.tabitem
{
    width: 160rpx;
    position: relative;
    height: 60rpx;
    line-height: 60rpx;
    font-size: 28rpx;
    color: #999999;
    text-align: center;
}
.bomline
{
    position: absolute;
    width: 60rpx;
    height: 6rpx;
    background-color: #3A9DA7;
    border-radius: 3rpx;
    bottom: -5rpx;
    left: 50rpx;
}
.tabline
{
    width: 2rpx;
    height: 32rpx;
    background-color: #D9D9D9;
}
.tab-active
{
    font-size: 32rpx;
    font-weight: bold;
    color: #333333;
}

.list
{
    margin-top: 100rpx;
    padding: 30rpx;
    padding-top: 0;
    box-sizing: border-box;
}
.litem
{
    padding: 20rpx 0;
    display: flex;
    /* height: 176rpx; */
    position: relative;
}
.litem image
{
    width: 200rpx;
    height: 160rpx;
    border-radius: 10rpx;
    background-color: #f8f8f8;
}
.linfo
{
    height: 160rpx;
    position: relative;
    width: calc(690rpx - 230rpx);
}
.markbox
{
  position: absolute;
  bottom: 3rpx;
  left: 0;
}
.lmark
{
    background-color: #E9FAFB;
    height: 36rpx;
    line-height: 36rpx;
    text-align: center;
    padding: 0 20rpx;
    color: #3A9DA7;
    font-size: 24rpx;
    margin-right: 20rpx;
}
.state
{
    position: absolute;
    top: 20rpx;
    left: 0;
    width: 100rpx;
    height: 36rpx;
    border-top-left-radius: 15rpx;
    border-bottom-right-radius: 15rpx;
    text-align: center;
    line-height: 36rpx;
    font-size: 24rpx;
    color: #ffffff;
}
.ing
{
    background-color: #3A9DA7;
}
.nopass
{
    background-color: #BA3E3E;
}
.down
{
    background-color: #E4912F;
}
.yytip
{
    width: 100%;
    height: 60rpx;
    background: #e9fafb;
    position: fixed;
    left: 0;
    bottom: env(safe-area-inset-bottom);
    color: #3A9DA7;
    font-size: 28rpx;
    text-align: center;
    line-height: 60rpx;
}